{
  "name": "solara",
  "version": "1.0.0",
  "private": true,
  "description": "一个极简风格的基于免费API的音乐播放器（Cloudflare Workers 版）",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:schema": "wrangler d1 execute solara-db --remote --file=./schema.sql",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250816.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
